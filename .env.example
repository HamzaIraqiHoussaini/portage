# Microsoft Foundry (Anthropic Messages API)
FOUNDRY_MESSAGES_URL=https://YOUR-RESOURCE.services.ai.azure.com/anthropic/v1/messages
FOUNDRY_API_KEY=
FOUNDRY_MODEL=claude-opus-5
ANTHROPIC_VERSION=2023-06-01
