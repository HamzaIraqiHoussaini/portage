# Provider: foundry | aws
PROVIDER=foundry

# Microsoft Foundry (Anthropic Messages API)
FOUNDRY_MESSAGES_URL=https://YOUR-RESOURCE.services.ai.azure.com/anthropic/v1/messages
FOUNDRY_API_KEY=
FOUNDRY_MODEL=claude-opus-5
ANTHROPIC_VERSION=2023-06-01
FOUNDRY_MAX_TOKENS=8192

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_MODEL_ID=anthropic.claude-opus-4-20250514-v1:0

# App
APP_HOST=127.0.0.1
APP_PORT=8765
WRITEBACK_ENABLED=true
CURSOR_LINK_ENABLED=true
CLAUDE_CODE_LINK_ENABLED=true
SKILLS_MAX_CHARS=120000
